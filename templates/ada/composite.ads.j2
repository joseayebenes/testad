with ICD_Bitio;
{% for w in f.withs %}with {{ w }};
{% endfor %}

package {{ f.package_name }} is

{% for c in f.classes %}
   --  {{ c.kind_label }} '{{ c.icd_name }}' -- ICD: {{ c.path }} [{{ c.icd_id }}]
{% for line in c.local_decls %}   {{ line }}
{% endfor %}
   type {{ c.type_name }} is record
{% for comp in c.components %}      {{ comp.name }} : {{ comp.type_name }}{{ comp.default }};  --  {{ comp.comment }}
{% endfor %}   end record;

   {{ c.type_name }}_Bit_Length : constant := {{ c.bit_length }};

   procedure Pack (Item : {{ c.type_name }};
                   Data : in out ICD_Bitio.Byte_Array;
                   Base : Natural);
   procedure Unpack (Item : out {{ c.type_name }};
                     Data : ICD_Bitio.Byte_Array;
                     Base : Natural);

{% endfor %}
end {{ f.package_name }};
