def encode(msg: {{ msg.payload_class }}) -> bytes:
    """Empaqueta el mensaje (valores crudos) a bytes."""
    buf = bitio.BitBuffer(BYTE_LENGTH * 8)
    msg.pack_into(buf, 0)
    return buf.to_bytes()


def decode(data: bytes) -> {{ msg.payload_class }}:
    """Desempaqueta bytes al mensaje (valores crudos)."""
    if len(data) < BYTE_LENGTH:
        raise bitio.DecodeError(
            f"esperados {BYTE_LENGTH} bytes, recibidos {len(data)}")
    buf = bitio.BitBuffer.from_bytes(data)
    return {{ msg.payload_class }}.unpack_from(buf, 0)
